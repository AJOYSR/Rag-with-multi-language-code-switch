PY := .venv/bin/python
EXP := cd 05_experiments &&

.PHONY: env test review-sheet smoke pilot analyze-pilot items dev

env:            ## create the pinned environment
	uv venv --python 3.11 .venv && uv pip install --python $(PY) -r requirements.txt

test:           ## unit tests for normalisation, scoring and run guards
	$(EXP) ../$(PY) -m pytest -q

review-sheet:   ## regenerate author review sheets from the draft items
	$(EXP) ../$(PY) -m src.build_review_sheet ../03_data/processed/pilot_items_draft.yaml ../03_data/variants

smoke:          ## pipeline smoke test on 2 draft items (not a result)
	$(EXP) ../$(PY) -m src.run configs/smoke_qwen35_9b.yaml && ../$(PY) -m src.run configs/smoke_gemma2_9b.yaml

pilot:          ## G2 pilot (requires author-approved items)
	$(EXP) ../$(PY) -m src.run configs/pilot_qwen35_9b.yaml && ../$(PY) -m src.run configs/pilot_gemma2_9b.yaml

analyze-pilot:  ## score pilot runs -> 06_results/tables
	$(EXP) ../$(PY) -m src.analyze_pilot runs/$(RUN)

items:          ## combined author-reviewed item file (pilot + main) used by all main runs
	$(PY) -c "import yaml; from pathlib import Path; L=lambda p: yaml.safe_load(Path(p).read_text(encoding='utf-8')); Path('03_data/processed/items_v1.yaml').write_text('# pilot + main author-reviewed items (generated by make items; do not hand-edit)\\n' + yaml.safe_dump(L('03_data/processed/pilot_items_approved.yaml') + L('03_data/processed/main_items_approved.yaml'), allow_unicode=True, sort_keys=False), encoding='utf-8')"

dev:            ## Phase 4c dev runs (M3 combiner fit, threshold selection)
	$(EXP) ../$(PY) -m src.run configs/dev_qwen35_9b.yaml && ../$(PY) -m src.run configs/dev_gemma2_9b.yaml
